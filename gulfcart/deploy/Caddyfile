# HTTPS certificates are issued automatically for both hosts.
{$DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy nginx:80
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Same backend, used by payment webhooks (Tap) and the product feed URLs.
{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy nginx:80
}
