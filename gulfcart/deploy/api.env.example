# Copy to deploy/api.env on the server and fill in. Never commit the real file.
APP_NAME=GulfCart
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # php artisan key:generate --show
APP_URL=https://api.gulfcart.com
FRONTEND_URL=https://gulfcart.com
SANCTUM_STATEFUL_DOMAINS=gulfcart.com,www.gulfcart.com
SESSION_DOMAIN=.gulfcart.com
SESSION_SECURE_COOKIE=true
CORS_ALLOWED_ORIGINS=https://gulfcart.com,https://www.gulfcart.com

DB_CONNECTION=pgsql
DB_PORT=5432
DB_DATABASE=gulfcart
DB_USERNAME=gulfcart
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
LOG_CHANNEL=stderr
CATALOG_DISK=public

# Email (Postmark, Amazon SES, Brevo… any SMTP)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=orders@gulfcart.com
MAIL_FROM_NAME=GulfCart
OPERATIONS_ALERT_EMAIL=ops@gulfcart.com

# Payments
PAYMENT_PROVIDER=tap
TAP_SECRET_KEY=
TAP_WEBHOOK_BASE_URL=https://api.gulfcart.com
PAYMENT_FEE_PERCENT=2.5

# Supplier
CJ_API_KEY=
CJ_AUTO_PAY=true

# SMS sign-in codes and WhatsApp
SMS_PROVIDER=unifonic
SMS_SENDER=GulfCart
UNIFONIC_APP_SID=
WHATSAPP_PROVIDER=none
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# Support and marketing
SUPPORT_EMAIL=support@gulfcart.com
SUPPORT_WHATSAPP=
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
SNAP_PIXEL_ID=
GA4_MEASUREMENT_ID=

# Arabic machine translation of imported products
TRANSLATION_PROVIDER=claude
ANTHROPIC_API_KEY=

# Live exchange rates
FX_PROVIDER=http
