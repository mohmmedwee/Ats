APP_NAME=GulfCart
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=gulfcart
DB_USERNAME=gulfcart
# Local development only. Real credentials are injected by the platform, never committed.
DB_PASSWORD=gulfcart_dev_only

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000

QUEUE_CONNECTION=redis
CACHE_STORE=redis
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@gulfcart.local"
MAIL_FROM_NAME="${APP_NAME}"

DEFAULT_COUNTRY=AE
SUPPORTED_COUNTRIES=AE,SA
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,ar
MFA_ISSUER=GulfCart

# Local development only: DevSuperAdminSeeder creates this super admin.
GULFCART_DEV_ADMIN_EMAIL=admin@gulfcart.local
GULFCART_DEV_ADMIN_PASSWORD=ChangeMe-123
