APP_NAME=GulfCart
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=gulfcart
DB_USERNAME=gulfcart
# Local development only. Real credentials are injected by the platform, never committed.
DB_PASSWORD=gulfcart_dev_only

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000

QUEUE_CONNECTION=redis
CACHE_STORE=redis
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@gulfcart.local"
MAIL_FROM_NAME="${APP_NAME}"

CATALOG_DISK=public
CORS_ALLOWED_ORIGINS=http://localhost

# Payments: sandbox until a provider is contracted (decision D2). Never use sandbox in production.
PAYMENT_PROVIDER=sandbox
PAYMENT_SANDBOX_SECRET=sandbox-dev-secret-change-me
PAYMENT_FEE_PERCENT=2.9

FX_PROVIDER=config
# FX_HTTP_URL=https://open.er-api.com/v6/latest/{base}
FX_MAX_CHANGE_PERCENT=10
FX_BUFFER_PERCENT=1.5
FX_MAX_AGE_HOURS=24
QUOTE_VALIDITY_MINUTES=30
ORDER_PAYMENT_WINDOW_MINUTES=60
PROCUREMENT_MAX_COST_INCREASE_PERCENT=5
OPERATIONS_ALERT_EMAIL=operations@gulfcart.local
INVOICE_SELLER_NAME="GulfCart (legal entity pending)"

DEFAULT_COUNTRY=AE
SUPPORTED_COUNTRIES=AE,SA
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,ar
MFA_ISSUER=GulfCart

# Local development only: DevSuperAdminSeeder creates this super admin.
GULFCART_DEV_ADMIN_EMAIL=admin@gulfcart.local
GULFCART_DEV_ADMIN_PASSWORD=ChangeMe-123

# CJdropshipping supplier (docs/suppliers/CJ_DROPSHIPPING.md). Key from CJ: My CJ > Authorization > API.
CJ_API_KEY=
# CJ_LOGISTICS="CJPacket Ordinary,YunExpress"
CJ_AUTO_PAY=true

# Arabic machine translation of imported products (none | claude). Uses the Claude API.
TRANSLATION_PROVIDER=none
# ANTHROPIC_API_KEY=

# Storefront support channels
SUPPORT_EMAIL=support@gulfcart.example
# SUPPORT_WHATSAPP=971500000000
# Marketing tags (loaded only after cookie consent)
# META_PIXEL_ID=
# TIKTOK_PIXEL_ID=
# SNAP_PIXEL_ID=
# GA4_MEASUREMENT_ID=

# SMS for sign-in codes: log | twilio | unifonic
SMS_PROVIDER=log
# SMS_SENDER=GulfCart
# TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN=
# UNIFONIC_APP_SID=
