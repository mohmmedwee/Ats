# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Data stores
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://jobagent:jobagent@localhost:5432/jobagent
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Secrets. Generate with: python scripts/generate_keys.py
# Never commit real values. Use a secret manager outside local development.
# ---------------------------------------------------------------------------
SECRET_KEY=change-me
ENCRYPTION_KEY=change-me

# ---------------------------------------------------------------------------
# AI runtime. Any OpenAI-compatible endpoint works: Ollama, MLX-LM, vLLM.
# ---------------------------------------------------------------------------
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
AI_MODEL=qwen2.5:14b-instruct
AI_TIMEOUT_SECONDS=120
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Policy. See job-agent-plan.md sections 4 and 7.8.
# Autonomy level 3 (guarded auto-submit) is not settable here by design.
# ---------------------------------------------------------------------------
AUTONOMY_LEVEL=2
MAX_APPLICATIONS_PER_DAY=10
DISCOVERY_CRON=0 7 * * *
DISCOVERY_TIMEZONE=Asia/Amman
CHAT_DAILY_TOKEN_BUDGET=200000
CHAT_MAX_TOOL_CALLS_PER_TURN=8
CHAT_CONFIRMATION_TTL_SECONDS=900
